<UserControl x:Class="TiendaMVVM.Views.ProductosView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="280"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <DataGrid Grid.Column="0" ItemsSource="{Binding Productos}"
                  SelectedItem="{Binding Seleccionado, Mode=TwoWay}"
                  AutoGenerateColumns="False" IsReadOnly="True"
                  SelectionMode="Single" CanUserAddRows="False">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Id" Binding="{Binding Id}" Width="50"/>
                <DataGridTextColumn Header="Nombre" Binding="{Binding Nombre}" Width="*"/>
                <DataGridTextColumn Header="Precio" Binding="{Binding Precio, StringFormat=N2}" Width="90"/>
                <DataGridTextColumn Header="Categoría" Binding="{Binding Categoria.Nombre}" Width="120"/>
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Column="1" Margin="12,0,0,0">
            <TextBlock Text="Nombre" FontWeight="SemiBold"/>
            <TextBox Text="{Binding Nombre, UpdateSourceTrigger=PropertyChanged}" Margin="0,2,0,10"/>

            <TextBlock Text="Precio" FontWeight="SemiBold"/>
            <TextBox Text="{Binding PrecioTexto, UpdateSourceTrigger=PropertyChanged}" Margin="0,2,0,10"/>

            <TextBlock Text="Categoría" FontWeight="SemiBold"/>
            <ComboBox ItemsSource="{Binding Categorias}" DisplayMemberPath="Nombre"
                      SelectedItem="{Binding Categoria}" Margin="0,2,0,16"/>

            <Button Content="Agregar" Command="{Binding AgregarCommand}" Margin="0,0,0,6" Padding="6"/>
            <Button Content="Guardar cambios" Command="{Binding GuardarCommand}" Margin="0,0,0,6" Padding="6"/>
            <Button Content="Eliminar" Command="{Binding EliminarCommand}" Margin="0,0,0,6" Padding="6"/>
            <Button Content="Limpiar" Command="{Binding LimpiarCommand}" Padding="6"/>
        </StackPanel>

        <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Text="{Binding Mensaje}"
                   Margin="0,10,0,0" Foreground="DimGray" TextWrapping="Wrap"/>
    </Grid>
</UserControl>