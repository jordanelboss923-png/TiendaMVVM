<Window x:Class="TiendaMVVM.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:TiendaMVVM.Views"
        Title="Tienda MVVM · INF033" Height="520" Width="860"
        WindowStartupLocation="CenterScreen">
    <TabControl>
        <TabItem Header="Productos">
            <views:ProductosView DataContext="{Binding Productos}"/>
        </TabItem>
        <TabItem Header="Reportes">
            <views:ReportesView DataContext="{Binding Reportes}"/>
        </TabItem>
    </TabControl>
</Window>